{
  "name": "self-hosted-power-automate-mcp",
  "version": "0.1.0",
  "description": "Self-hosted Model Context Protocol server for Power Automate cloud flows.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && node dist/index.js",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "test": "pnpm build:test && node --test dist-tests/tests/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "smoke": "node dist/index.js --smoke"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
