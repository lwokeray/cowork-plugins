# MCP transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
# Required for http mode. Never commit a real key.
MCP_HTTP_API_KEY=
# Optional comma-separated exact origins. Empty means no browser Origin is accepted except absent Origin.
MCP_ALLOWED_ORIGINS=

POWER_PLATFORM_API_URL=https://api.powerplatform.com
POWER_PLATFORM_API_VERSION=2024-10-01
POWER_PLATFORM_TENANT_ID=
# Provide exactly one of the following, or set ENTRA_CLIENT_ID + ENTRA_TENANT_ID for device-code login.
POWER_PLATFORM_ACCESS_TOKEN=
POWER_PLATFORM_ACCESS_TOKEN_FILE=
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
POWER_PLATFORM_SCOPE=https://api.powerplatform.com/.default

REQUEST_TIMEOUT_MS=30000
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=5242880
MAX_PAGE_SIZE=100

STORE_ENABLED=true
STORE_PATH=./data/store.json
LOG_LEVEL=info
